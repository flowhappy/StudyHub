(code){\r\n      this.isFade=code\r\n    },\r\n    startEdit(code){\r\n      this.noEdit=code\r\n    }\r\n  }\r\n\r\n}\r\n</script>\r\n\r\n<style>\r\n@import \"github-markdown-css\";\r\n.el-dialog{\r\n  background-color: rgba(255,255,255,0.9);\r\n  border-radius: 20px;\r\n}\r\nbody{\r\n  background-color: #FFECE9;\r\n  transition: 300ms !important;\r\n}\r\n</style>\r\n"]},"metadata":{},"sourceType":"module"}